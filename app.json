{
  "expo": {
    "name": "Baroblogs",
    "slug": "Baroblogs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/blogs_icon.png",
    "scheme": "baroblogs",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/blogs_icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.baro28.Baroblogs"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/blogs_icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/blogs_icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6f780760-cd31-4df8-bc09-14d9c103659b"
      }
    }
  }
}
